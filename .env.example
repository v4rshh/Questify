# PostgreSQL
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://questify:change-me@db:5432/questify

# Infrastructure
REDIS_URL=redis://redis:6379/0
WEB_ORIGIN=http://localhost:3000

# LLM Provider (Groq only)
# Get a free Groq key at https://console.groq.com/keys
LLM_API_KEY=
# Verify current free-tier model names on your provider's dashboard before relying on these.
LLM_MODEL=openai/gpt-oss-20b

# Course-scoped RAG (embeddings run locally; answer generation uses Groq above)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=questify_materials
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MAX_RETRIES=1
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE_MB=25
