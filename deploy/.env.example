# Public hostname whose DNS A/AAAA record points to the server.
DOMAIN=questify.example.com
WEB_ORIGIN=https://questify.example.com

# The browser calls the API through Caddy on the same origin.
NEXT_PUBLIC_API_URL=/api/v1

# Generate both values before deployment. Do not reuse these examples.
POSTGRES_DB=questify
POSTGRES_USER=questify
POSTGRES_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-48-random-characters

# Groq API configuration.
LLM_API_KEY=replace-with-your-groq-key
LLM_MODEL=openai/gpt-oss-20b

# Persistent RAG configuration inside the API container.
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
CHROMA_COLLECTION_NAME=questify_materials
UPLOAD_DIRECTORY=/app/data/uploads
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_MAX_RETRIES=1
MAX_UPLOAD_SIZE_MB=25
